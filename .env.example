# HTTPS JSON feed supplied by a retailer, affiliate network, or licensed data provider.
CATALOG_FEED_URL=
# Optional bearer token for the configured feed.
CATALOG_FEED_TOKEN=
CATALOG_FEED_TIMEOUT_MS=5000

# eBay Browse API credentials. Keep these server-side and set them in Vercel.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_TIMEOUT_MS=7000
